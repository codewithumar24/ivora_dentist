APP_NAME="Ivora Dental Studio"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Karachi
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ivora_dental
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# ---- Mail (Mailtrap / Gmail SMTP / Mailpit) -------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="care@ivoradental.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---- SMS ------------------------------------------------------------------
# drivers: log | twilio
SMS_DRIVER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# ---- Clinic defaults ------------------------------------------------------
CLINIC_SLOT_MINUTES=30
CLINIC_REMINDER_HOURS=24
CLINIC_MAX_ADVANCE_DAYS=60
